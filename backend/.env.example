# EV Hub Backend Environment Variables
# Copy to .env and fill in your own values
PORT=3000
NODE_ENV=development
DB_HOST=your_aiven_host.aivencloud.com
DB_PORT=10997
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=your_db_password_here
JWT_SECRET=your_jwt_secret_here_must_be_48_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM=your_email@gmail.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5177
WAITLIST_CHECK_SECONDS=5
ADMIN_NAME=EV Hub Admin
ADMIN_EMAIL=admin@evhub.com
ADMIN_PASSWORD=change_me_on_production
